{
  "name": "@fiducy/assistant-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "bun": "./src/server.ts",
      "default": "./dist/server.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target browser --external react --external react/jsx-runtime --external @assistant-ui/react --external @fiducy/sdk && bun build src/server.ts --outdir dist --target node --external ai"
  },
  "peerDependencies": {
    "@assistant-ui/react": "0.15.28",
    "@fiducy/sdk": "workspace:*",
    "ai": "7.0.139",
    "react": "19.2.0"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.28",
    "@fiducy/sdk": "workspace:*",
    "@types/react": "19.2.2",
    "ai": "7.0.139",
    "react": "19.2.0"
  }
}
