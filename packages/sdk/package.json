{
  "name": "@fiducy/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./src/react.ts",
      "bun": "./src/react.ts",
      "default": "./dist/react.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "bun": "./src/server.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/react.ts --outdir dist --target browser --external react --external react/jsx-runtime --external @tanstack/react-query && bun build src/server.ts --outdir dist --target node"
  },
  "dependencies": {
    "@fiducy/core": "workspace:*",
    "@fiducy/widget": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.2.0",
    "@tanstack/react-query": "^5.104.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@ai-sdk/openai": "4.0.93",
    "@fiducy/testing": "workspace:*",
    "@tanstack/react-query": "5.104.2",
    "@types/react": "19.2.2",
    "ai": "7.0.139",
    "zod": "3.25.76"
  }
}
